// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "Ubuntu",
  "dockerComposeFile": ["./docker-compose.yml"],
  "workspaceFolder": "/workspaces/oi-polymarket",
  "service": "dev",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/nlstn/devcontainer-features/psql:1": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [12968],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "/usr/local/share/nvm/nvm.sh install && /usr/local/share/nvm/nvm.sh use && corepack enable && corepack pnpm --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "ms-ossdata.vscode-pgsql",
        "TypeScriptTeam.native-preview",
        "ms-edgedevtools.vscode-edge-devtools",
        "firefox-devtools.vscode-firefox-debug",
        "Prisma.prisma"
      ]
    }
  }

  // Configure tool-specific properties.
  // "customizations": {},

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
